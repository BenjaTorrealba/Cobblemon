// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Admin {
  id           Int    @id @default(autoincrement())
  username     String @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Tournament {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  format      String
  rules       String
  startDate   DateTime
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  players     TournamentPlayer[]
  matches     Match[]
  userEntries UserTournamentEntry[]
}

model Player {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())

  tournaments TournamentPlayer[]
}

model TournamentPlayer {
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  tournamentId Int
  player       Player     @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId     Int
  joinedAt     DateTime   @default(now())

  @@id([tournamentId, playerId])
}

model News {
  id          Int      @id @default(autoincrement())
  title       String
  content     String
  category    String   @default("general") // general | tournament | update
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  comments    Comment[]
  reactions   Reaction[]
}

model Match {
  id           Int        @id @default(autoincrement())
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  tournamentId Int
  user1        User       @relation("User1Matches", fields: [user1Id], references: [id])
  user1Id      Int
  user2        User       @relation("User2Matches", fields: [user2Id], references: [id])
  user2Id      Int
  scheduledAt  DateTime
  status       String     @default("scheduled") // scheduled | completed
  winner       User?      @relation("WonMatches", fields: [winnerId], references: [id])
  winnerId     Int?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model User {
  id                Int      @id @default(autoincrement())
  username          String   @unique
  passwordHash      String
  createdAt         DateTime @default(now())
  bio               String   @default("")
  favoritePokemonId Int      @default(0)
  // Pokédex
  pokedexSeen       Int      @default(0)
  pokedexCaught     Int      @default(0)
  // Region completion
  kantoCompleted    Boolean  @default(false)
  johtoCompleted    Boolean  @default(false)
  hoennCompleted    Boolean  @default(false)
  sinnohCompleted   Boolean  @default(false)
  unovaCompleted    Boolean  @default(false)
  kalosCompleted    Boolean  @default(false)
  alolaCompleted    Boolean  @default(false)
  galarCompleted    Boolean  @default(false)
  paldeaCompleted   Boolean  @default(false)

  teams              Team[]
  tournamentEntries  UserTournamentEntry[]
  matchesAsUser1     Match[] @relation("User1Matches")
  matchesAsUser2     Match[] @relation("User2Matches")
  wonMatches         Match[] @relation("WonMatches")
  comments           Comment[]
  reactions          Reaction[]
  showcasePokemons   ShowcasePokemon[]
}

model ShowcasePokemon {
  id          Int    @id @default(autoincrement())
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int
  pokemonId   Int
  pokemonName String
  slot        Int    @default(0)
}

model Team {
  id          Int           @id @default(autoincrement())
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int
  name        String        @default("Mi Equipo")
  description String        @default("")
  published   Boolean       @default(false)
  updatedAt   DateTime      @updatedAt
  pokemons    TeamPokemon[]
  comments    Comment[]
  reactions   Reaction[]
}

model TeamPokemon {
  id          Int    @id @default(autoincrement())
  team        Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId      Int
  slot        Int
  pokemonName String
  pokemonId   Int
  shiny       Boolean @default(false)
  item        String @default("")
  ability     String @default("")
  move1       String @default("")
  move2       String @default("")
  move3       String @default("")
  move4       String @default("")

  @@unique([teamId, slot])
}

model SiteSettings {
  id               Int    @id @default(1)
  registrationCode String @default("")
}

model UserTournamentEntry {
  id             Int             @id @default(autoincrement())
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         Int
  tournament     Tournament      @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  tournamentId   Int
  registeredAt   DateTime        @default(now())
  changesAllowed Boolean         @default(false)
  registeredTeam RegisteredTeam?

  @@unique([userId, tournamentId])
}

model RegisteredTeam {
  id          Int                    @id @default(autoincrement())
  entry       UserTournamentEntry    @relation(fields: [entryId], references: [id], onDelete: Cascade)
  entryId     Int                    @unique
  name        String
  description String                 @default("")
  lockedAt    DateTime               @default(now())
  pokemons    RegisteredTeamPokemon[]
}

model RegisteredTeamPokemon {
  id          Int            @id @default(autoincrement())
  team        RegisteredTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId      Int
  slot        Int
  pokemonName String
  pokemonId   Int
  shiny       Boolean @default(false)
  item        String @default("")
  ability     String @default("")
  move1       String @default("")
  move2       String @default("")
  move3       String @default("")
  move4       String @default("")

  @@unique([teamId, slot])
}

model Comment {
  id        Int      @id @default(autoincrement())
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  Int
  content   String
  createdAt DateTime @default(now())

  team      Team?    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId    Int?
  news      News?    @relation(fields: [newsId], references: [id], onDelete: Cascade)
  newsId    Int?
}

model Reaction {
  id       Int    @id @default(autoincrement())
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   Int
  emoji    String

  team     Team?  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId   Int?
  news     News?  @relation(fields: [newsId], references: [id], onDelete: Cascade)
  newsId   Int?

  @@unique([userId, emoji, teamId])
  @@unique([userId, emoji, newsId])
}
